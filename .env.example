# PostgreSQL Database Configuration
POSTGRES_USER=smartbin
POSTGRES_PASSWORD=smartbin123
POSTGRES_DB=smartbindb

# Database connection URL (for local running or tests, points to localhost; in docker-compose, connects to postgres service)
DATABASE_URL=postgresql://smartbin:smartbin123@localhost:5432/smartbindb

# ESP32 Configuration
# Set your ESP32's IP address on your WiFi network or college mobile hotspot
ESP32_IP=192.168.1.100
ESP32_PORT=80
POLL_INTERVAL_SECONDS=2.0

# Alert Thresholds (%)
MEDIUM_THRESHOLD=50
FULL_THRESHOLD=75
DANGER_THRESHOLD=80

